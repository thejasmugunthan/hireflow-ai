# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/hireflow_ai

# Authentication
JWT_SECRET=hireflow_super_secret_jwt_key_2026

# Cloudinary (Optional - will automatically use local storage fallback if left empty)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI (Optional - will automatically use intelligent heuristic analysis fallback if left empty)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
